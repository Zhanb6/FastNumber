# --- Database ---
POSTGRES_DB=eventdraw
POSTGRES_USER=eventdraw
POSTGRES_PASSWORD=change_me

# --- Backend ---
SECRET_KEY=change_me_long_random_string
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
PUBLIC_BASE_URL=http://localhost
# Optional: if set, /draw, /api/live/current and /ws/live require ?key=<value>
DRAW_SCREEN_KEY=
# Set to true when served over HTTPS (adds Secure flag to the admin cookie).
# Default: derived from PUBLIC_BASE_URL scheme.
# COOKIE_SECURE=false

# --- Event defaults (first run) ---
EVENT_NAME=Kazakhstan Travel Forum 2026
EVENT_SLUG=ktf-2026
EVENT_TIMEZONE=Asia/Almaty
START_NUMBER=1000
MAX_NUMBER=2000
ON_MAX_REACHED=continue
# Registration name input: full (one "ФИО" field) or split (first + last name)
NAME_MODE=full
ALLOW_PREVIOUS_WINNERS=false
REGISTRATION_OPEN=true
REGISTER_RATE_LIMIT_PER_MIN=30

# --- Demo ---
SEED_DEMO=false

# --- Infra ---
HTTP_PORT=80
BACKUP_INTERVAL_SECONDS=900
BACKUP_KEEP=96
